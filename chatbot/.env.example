# ── Taskflow AI service ──────────────────────────────────────────────
# Your Groq key (console.groq.com → API Keys). With no key, the AI buttons stay hidden.
AI_API_KEY=

# Any OpenAI-compatible service works. Groq is the default.
AI_BASE_URL=https://api.groq.com/openai/v1
# Main model, and the one to try when the main one is busy or rate-limited.
AI_MODEL=openai/gpt-oss-120b
AI_FALLBACK_MODEL=llama-3.3-70b-versatile

# Where the Taskflow backend runs (the AI reads data through it, as the signed-in person).
BACKEND_URL=http://localhost:5000

# Where the frontend runs (allowed to call this service). Comma-separate several.
FRONTEND_URL=http://localhost:5174

PORT=8000
