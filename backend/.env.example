# Copy to .env and fill in. Never commit .env.
PORT=5000

# Supabase (Project Settings -> API)
SUPABASE_URL=
SUPABASE_API=

# Long random string used to sign login tokens.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Frontend address(es) allowed by CORS and used in email links (comma-separated)
FRONTEND_URL=http://localhost:5174

# Gmail used to send reminders (use a Gmail App Password, not your normal one)
EMAIL_USER=
EMAIL_PASS=

# ── Optional integrations (each one stays off until its values are set) ──

# Separate key for encrypting stored tokens (defaults to JWT_SECRET).
# Set it once and never change it, or users must reconnect Google/GitHub/Jira/Slack.
ENCRYPTION_KEY=

# SMS reminders — Twilio (console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Google Calendar — Google Cloud console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/integrations/google/callback

# Browser push — optional; generated automatically on first start if empty
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# AI (Phase C) — the AI service in /chatbot asks this backend for permission and
# records usage here. Daily limits per person and per company (counted in requests).
AI_DAILY_LIMIT_USER=60
AI_DAILY_LIMIT_COMPANY=600

# Behind a reverse proxy (Render, Railway, Nginx…)? Set to 1 so public-page rate limits see real visitor IPs
TRUST_PROXY=
